# Copy to .env and adjust. Every variable is validated at startup (apps/api/src/env.ts).

# PostgreSQL 16+ connection string
DATABASE_URL=postgresql://et:et@localhost:5432/expense_tracker

# Public URL people open in the browser (used for auth cookies and CSRF checks).
# In development this is the Vite dev server.
PUBLIC_URL=http://localhost:5173

# Random secret for signing sessions: generate one with `openssl rand -base64 32`
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Reverse proxies whose X-Forwarded-For header is believed when working out a visitor's address
# (sign-in rate limits, the signed-in devices list). loopback and private cover a proxy on this
# machine or Docker network; use none, or list addresses/CIDR ranges (e.g. 203.0.113.10,10.0.0.0/8).
TRUST_PROXY=loopback,private

# API server
PORT=3000
LOG_LEVEL=info

# Background jobs (exchange rates, trash cleanup) run inside the API process unless false.
RUN_WORKER=true

# Fetch daily exchange rates from Nepal Rastra Bank.
FX_NRB_ENABLED=true

# Set to false once your own account exists to stop strangers from signing up.
ALLOW_SIGNUP=true

# Optional: send notifications (bills due, budgets running low…) by email too.
# Leave SMTP_URL empty to keep them in the app only.
SMTP_URL=
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="Expense Tracker <no-reply@example.com>"

# Push notifications to browsers and installed apps (Web Push). On by default. The server makes
# its VAPID key pair on first start and keeps it in the database; set both keys here to manage
# them yourself (generate with `npx web-push generate-vapid-keys`). Changing keys means every
# device has to turn push on again.
WEB_PUSH=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services: mailto: or https: (defaults from MAIL_FROM or PUBLIC_URL).
VAPID_SUBJECT=
# Devices can only subscribe through the major browsers' push services (Google, Mozilla, Microsoft,
# Apple). List any other push service host names here, comma separated.
PUSH_EXTRA_HOSTS=

# Optional AI helpers: receipt scan, reading PDF statements, category suggestions, "ask your
# money", and a fallback for quick add when the rules can't read what was typed. Off unless a key
# is set here, and then each workspace's owner or admin still has to turn them on (Settings →
# General). Only what a helper needs is sent to the Claude API (see the note in that setting).
ANTHROPIC_API_KEY=
# The model the helpers use. Set claude-haiku-4-5 for lower cost on simple extraction.
AI_MODEL=claude-opus-5-5
# AI requests allowed per workspace per day.
AI_DAILY_LIMIT=200

# Key for secrets the server must read back later (webhook signing secrets, bank connections),
# stored encrypted. Defaults to one derived from AUTH_SECRET; set it (32+ characters) if you might
# change AUTH_SECRET, since changing the key makes those secrets unreadable.
ENCRYPTION_KEY=

# Webhooks can't reach private network addresses (192.168.x.x, localhost…) unless this is true,
# e.g. to send changes to Home Assistant on your home network.
WEBHOOK_ALLOW_PRIVATE=false

# Email in: each workspace gets a private address for forwarded receipts and bank alert emails.
# Put {token} where the workspace's secret goes. Two ways to receive the mail:
#  1. One mailbox read over IMAP, using plus-addressing (e.g. a Gmail account with an app password):
#       EMAIL_IN_ADDRESS=money+{token}@gmail.com
#       EMAIL_IN_IMAP_URL=imaps://money%40gmail.com:app-password@imap.gmail.com:993
#  2. A domain whose mail a service posts to POST /api/inbound/email (raw message as the body,
#     "Authorization: Bearer <EMAIL_IN_SECRET>", optional ?to=<recipient>), e.g. a Cloudflare
#     Email Worker:
#       EMAIL_IN_ADDRESS={token}@in.example.com
#       EMAIL_IN_SECRET=a-long-random-string
EMAIL_IN_ADDRESS=
EMAIL_IN_IMAP_URL=
EMAIL_IN_IMAP_FOLDER=INBOX
EMAIL_IN_SECRET=

# Bank sync through SimpleFIN Bridge (read-only; mostly US banks). Owners and admins connect with
# a setup token from SimpleFIN; credentials are kept encrypted (see ENCRYPTION_KEY). No provider
# covers banks in Nepal yet. Set to false to hide it.
BANK_SYNC=true
