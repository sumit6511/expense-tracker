{
  "name": "@et/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed-cli.ts",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.6",
    "@et/shared": "workspace:*",
    "@hono/node-server": "2.1.3",
    "@hono/zod-openapi": "1.6.3",
    "@node-rs/argon2": "2.2.1",
    "@scalar/hono-api-reference": "0.12.7",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.11",
    "nodemailer": "10.0.13",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "pino": "10.3.1",
    "web-push": "^3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "vitest": "5.0.2"
  }
}
